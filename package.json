{
  "name": "office-agent-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hexagonal office visualizer for Claude Code, Codex, OpenCode and Antigravity agent sessions.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "dev:server": "vite-node src/server.ts",
    "dev:client": "vite",
    "dev": "npm run dev:server & npm run dev:client",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.9.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "pixi.js": "^8.20.1"
  }
}
